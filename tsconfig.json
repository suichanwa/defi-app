{
  // Point directly to the Expo base config so the TS server resolves JSX/react-native types.
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@app-types": ["types"],
      "@app-types/*": ["types/*"],
      "@components": ["ui/components"],
      "@components/*": ["ui/components/*"],
      "@config": ["config"],
      "@config/*": ["config/*"],
      "@constants": ["constants"],
      "@constants/*": ["constants/*"],
      "@context": ["context"],
      "@context/*": ["context/*"],
      "@env": ["../types/env.d.ts"],
      "@hooks": ["hooks"],
      "@hooks/*": ["hooks/*"],
      "@i18n": ["i18n"],
      "@i18n/*": ["i18n/*"],
      "@screens": ["screens"],
      "@screens/*": ["screens/*"],
      "@services": ["services/index"],
      "@services/*": ["services/*"],
      "@styles/*": ["ui/styles/*"],
      "@theme": ["theme"],
      "@theme/*": ["theme/*"],
      "@utils": ["utils"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": [
    "src/**/*",
    "App.tsx",
    "index.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "metro.config.js",
    "babel.config.js"
  ]
}
