    "prettier": "^3.7.4",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-native|react-native|expo|@expo|@react-navigation|@unimodules|@react-native-community|expo-modules-core)/)"
