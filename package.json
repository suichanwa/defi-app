{
  "name": "defi-ai-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "eas build --platform android --profile preview --local --clear-cache",
    "build:dev:android": "eas build --platform android --profile development",
    "build:prod:android": "eas build --platform android --profile production",
    "build:dev:android:local": "eas build --platform android --profile development --local --clear-cache",
    "build:prod:android:local": "eas build --platform android --profile production --local --clear-cache",
    "build:local:clean-cache": "eas build --platform android --profile preview --local --clear-cache",
    "build:apk": "cd android && gradlew.bat clean assembleRelease && cd ..",
    "build:dev": "cd android && gradlew.bat clean assembleDebug && cd ..",
    "rust:wallet:build:android": "cd rust-wallet-core && cargo ndk -t armeabi-v7a -t arm64-v8a -t x86_64 -o ../android/app/src/main/jniLibs build --release && cd ..",
    "rust:wallet:check": "cd rust-wallet-core && cargo check && cd ..",
    "clean": "rimraf node_modules package-lock.json && npm install",
    "test": "jest"
  },
  "dependencies": {
